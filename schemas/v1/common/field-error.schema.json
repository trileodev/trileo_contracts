{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trileo.dev/v1/common/field-error.schema.json",
  "title": "FieldError",
  "type": "object",
  "additionalProperties": false,
  "required": ["field", "message"],
  "properties": {
    "field": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9.[\\]_-]*$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 300 }
  }
}
