{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trileo.dev/v1/common/anonymous-service-request.schema.json",
  "title": "AnonymousServiceRequest",
  "description": "Internal request envelope for explicitly anonymous operations. It cannot carry actor identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "correlationId", "payload"],
  "properties": {
    "version": { "const": 1 },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 },
    "payload": { "type": "object" }
  }
}
