{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trileo.dev/v1/organizations/organization-invitation-response.schema.json",
  "title": "OrganizationInvitationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organizationId",
    "organizationName",
    "email",
    "role",
    "status",
    "expiresAt",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "organizationName": {
      "$ref": "organization-name.schema.json"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "role": {
      "$ref": "organization-role.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
