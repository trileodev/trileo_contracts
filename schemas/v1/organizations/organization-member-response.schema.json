{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trileo.dev/v1/organizations/organization-member-response.schema.json",
  "title": "OrganizationMemberResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organizationId",
    "userId",
    "displayName",
    "role",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 201
    },
    "role": {
      "$ref": "organization-role.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
